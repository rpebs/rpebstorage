APP_NAME=rpebstorage
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8123
SERVER_PORT=8123

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# -----------------------------------------------------------------------------
# Database & Queue Configuration
# -----------------------------------------------------------------------------
# Pilihan 1 (Rekomendasi Local / Zero-Config): SQLite & Database Queue.
# Tidak perlu install MySQL maupun Redis! Cukup jalankan migrate.
DB_CONNECTION=sqlite
QUEUE_CONNECTION=database
CACHE_STORE=database
SESSION_DRIVER=database

# Pilihan 2 (Laragon / Production / VPS): MySQL & Redis
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=rpebstorage
# DB_USERNAME=root
# DB_PASSWORD=
# QUEUE_CONNECTION=redis
# CACHE_STORE=redis
# REDIS_CLIENT=predis

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

MEMCACHED_HOST=127.0.0.1
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# -----------------------------------------------------------------------------
# Initial Admin Credentials (seeded on php artisan db:seed)
# -----------------------------------------------------------------------------
ADMIN_NAME=Owner
ADMIN_EMAIL=admin@rpebstorage.local
ADMIN_PASSWORD=change-me-now

# -----------------------------------------------------------------------------
# Storage Provider Credentials
# -----------------------------------------------------------------------------
# Telegram MTProto (butuh Redis)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# TELEGRAM_DEV_DAEMON=true # uncomment jika ingin daemon telegram otomatis jalan di `composer dev`

# Google Drive OAuth2
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Dropbox OAuth2
DROPBOX_CLIENT_ID=
DROPBOX_CLIENT_SECRET=

# OneDrive / Microsoft Graph OAuth2
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

